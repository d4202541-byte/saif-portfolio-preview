    .contact-grid{position:relative;z-index:1;display:grid;grid-template-columns:.88fr 1.12fr}
    .contact-copy{padding:clamp(34px,5vw,64px);border-inline-end:1px solid var(--line)}
    .contact-copy h2{font-size:clamp(2rem,4.6vw,4rem);line-height:1.22;letter-spacing:-.045em;margin:0;max-width:12ch}
    html[dir="rtl"] .contact-copy h2{line-height:1.43;letter-spacing:-.015em}
    .contact-copy p{color:#aaa6a0;margin:18px 0 0;max-width:48ch}
    .direct-links{display:grid;gap:10px;margin-top:32px}
    .direct-link{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:14px 0;border-bottom:1px solid var(--line);font-family:var(--font-en);font-size:.76rem;color:#c9c5bf}
    .direct-link b{color:#77736e;font-size:.64rem;letter-spacing:.08em;text-transform:uppercase}
    .direct-link:hover span{color:var(--accent)}
    .contact-form{padding:clamp(34px,5vw,64px);display:grid;align-content:center}
    .form-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
    .field{display:grid;gap:8px;margin-bottom:16px}
    .field label{font-size:.73rem;color:#a7a39d}
    .field input,.field select,.field textarea{width:100%;border:1px solid var(--line);background:#0e0e11;color:#fff;border-radius:13px;padding:13px 14px;transition:.2s;outline:none}
