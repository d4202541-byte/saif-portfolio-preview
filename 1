  <style>
    :root{
      --bg:#0b0b0d;
      --panel:#121216;
      --panel-2:#18181d;
      --text:#f6f3ee;
      --muted:#aaa7a2;
      --soft:#d9d4cc;
      --accent:#ff8f6b;
      --accent-2:#ffb18f;
      --line:rgba(255,255,255,.11);
      --line-strong:rgba(255,255,255,.2);
      --success:#98e0b0;
      --shadow:0 30px 80px rgba(0,0,0,.35);
      --radius:24px;
      --radius-sm:14px;
      --max:1220px;
      --pad:clamp(18px,4vw,56px);
      --font-ar:"IBM Plex Sans Arabic",system-ui,sans-serif;
      --font-en:"Manrope",system-ui,sans-serif;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth;scroll-padding-top:88px}
    body{margin:0;background:var(--bg);color:var(--text);font-family:var(--font-ar);line-height:1.72;-webkit-font-smoothing:antialiased;overflow-x:hidden}
    html[lang="en"] body{font-family:var(--font-en);line-height:1.62}
    body::before{content:"";position:fixed;inset:0;z-index:-2;background:
      radial-gradient(circle at 12% 0%,rgba(255,94,61,.18),transparent 34%),
      radial-gradient(circle at 88% 16%,rgba(255,143,107,.11),transparent 28%),
      linear-gradient(180deg,#0a0a0c,#0e0e12 55%,#09090b)}
    body::after{content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;opacity:.18;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.28'/%3E%3C/svg%3E")}
    a{color:inherit;text-decoration:none}
    img{display:block;max-width:100%}
    button,input,select,textarea{font:inherit}
    button{color:inherit}
    :focus-visible{outline:2px solid var(--accent);outline-offset:4px}
    .container{width:min(var(--max),calc(100% - (var(--pad) * 2)));margin-inline:auto}
    .section{padding-block:clamp(76px,10vw,132px)}
    .section-tight{padding-block:clamp(58px,7vw,88px)}
    .kicker{display:flex;align-items:center;gap:12px;margin:0 0 18px;color:var(--accent-2);font-family:var(--font-en);font-size:.75rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase}
    .kicker::before{content:"";width:32px;height:1px;background:var(--accent)}
    html[dir="rtl"] .kicker{letter-spacing:.02em}
    .section-title{font-size:clamp(2rem,5vw,4.25rem);line-height:1.14;letter-spacing:-.035em;margin:0;max-width:16ch}
    html[dir="rtl"] .section-title{letter-spacing:-.015em;line-height:1.3}
    .section-intro{max-width:66ch;margin:18px 0 0;color:var(--muted);font-size:clamp(.98rem,1.3vw,1.1rem)}
    .accent{color:var(--accent)}
    .eyebrow-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 6px rgba(255,143,107,.12)}
    .progress{position:fixed;inset-inline-start:0;top:0;z-index:110;height:2px;width:0;background:linear-gradient(90deg,var(--accent),#ffd0bc)}

    .nav{position:fixed;top:0;inset-inline:0;z-index:100;background:rgba(11,11,13,.72);backdrop-filter:blur(18px);border-bottom:1px solid rgba(255,255,255,.08)}
    .nav-inner{height:74px;display:flex;align-items:center;justify-content:space-between;gap:24px}
    .brand{display:flex;align-items:center;gap:12px;font-weight:800;white-space:nowrap}
    .brand-mark{width:34px;height:34px;display:grid;grid-template-columns:1fr 1fr;gap:3px;transform:rotate(0deg)}
    .brand-mark i{display:block;background:var(--accent);border-radius:12px 2px 12px 2px}
    .brand-mark i:nth-child(2),.brand-mark i:nth-child(3){border-radius:2px 12px 2px 12px}
    .brand-name{font-family:var(--font-en);font-size:.92rem;letter-spacing:.01em}
    .nav-links{display:flex;align-items:center;gap:28px;color:#c7c4bf;font-size:.9rem}
    .nav-links a{position:relative;transition:.2s}
    .nav-links a::after{content:"";position:absolute;inset-inline:0;bottom:-8px;height:1px;background:var(--accent);transform:scaleX(0);transition:.2s}
    .nav-links a:hover{color:#fff}.nav-links a:hover::after{transform:scaleX(1)}
    .nav-actions{display:flex;align-items:center;gap:9px}
    .icon-btn{border:1px solid var(--line);background:rgba(255,255,255,.03);border-radius:999px;height:40px;padding-inline:15px;cursor:pointer;transition:.2s;font-family:var(--font-en);font-size:.75rem;font-weight:800;letter-spacing:.08em}
    .icon-btn:hover{border-color:var(--line-strong);background:rgba(255,255,255,.08)}
    .menu-btn{display:none;width:42px;padding:0;align-items:center;justify-content:center}
    .menu-btn span,.menu-btn::before,.menu-btn::after{content:"";display:block;width:18px;height:1px;background:#fff;transition:.2s}
    .menu-btn span{margin:5px 0}
    .nav-cta{display:inline-flex;align-items:center;gap:8px;height:42px;padding-inline:18px;border-radius:999px;background:var(--text);color:#0a0a0c;font-weight:700;font-size:.84rem;transition:.2s}
    .nav-cta:hover{background:var(--accent);transform:translateY(-1px)}

    .hero{min-height:100svh;display:flex;align-items:center;padding-top:118px;padding-bottom:64px}
    .hero-grid{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(370px,.92fr);align-items:center;gap:clamp(38px,6vw,86px)}
    .hero-copy{position:relative;z-index:2}
    .availability{display:inline-flex;align-items:center;gap:12px;border:1px solid var(--line);background:rgba(255,255,255,.035);border-radius:999px;padding:8px 13px;margin-bottom:24px;color:#c8c4be;font-size:.78rem}
    .availability .live{width:8px;height:8px;border-radius:50%;background:var(--success);box-shadow:0 0 0 6px rgba(152,224,176,.1);animation:pulse 2s infinite}
    @keyframes pulse{50%{box-shadow:0 0 0 11px rgba(152,224,176,0)}}
    .hero h1{font-size:clamp(2.65rem,6.2vw,6rem);line-height:1.08;letter-spacing:-.055em;margin:0;max-width:12ch}
    html[dir="rtl"] .hero h1{line-height:1.23;letter-spacing:-.025em;max-width:11.5ch}
    .hero h1 strong{font-weight:700;color:var(--accent);font-style:normal}
    .hero-lead{margin:26px 0 0;color:#b9b5af;max-width:60ch;font-size:clamp(1rem,1.45vw,1.18rem)}
    .hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:34px}
    .btn{min-height:52px;display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:0 24px;border-radius:999px;border:1px solid var(--line-strong);font-weight:700;cursor:pointer;transition:.22s}
    .btn-primary{background:var(--accent);color:#15100e;border-color:var(--accent);box-shadow:0 12px 32px rgba(255,111,70,.22)}
    .btn-primary:hover{background:#ffab8f;transform:translateY(-2px);box-shadow:0 18px 38px rgba(255,111,70,.28)}
    .btn-secondary{background:rgba(255,255,255,.025)}
    .btn-secondary:hover{background:rgba(255,255,255,.08);transform:translateY(-2px)}
    .hero-meta{display:flex;flex-wrap:wrap;gap:18px 28px;margin-top:34px;color:#8f8c88;font-family:var(--font-en);font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
    .hero-meta span{display:flex;align-items:center;gap:8px}
    .hero-meta i{width:5px;height:5px;border-radius:50%;background:var(--accent)}
    .hero-visual{position:relative;max-width:550px;justify-self:end}
    .portrait-shell{position:relative;overflow:hidden;border-radius:34px;border:1px solid rgba(255,255,255,.16);background:#161317;box-shadow:var(--shadow);isolation:isolate}
    .portrait-shell::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 38%,rgba(11,11,13,.82) 100%);z-index:1;pointer-events:none}
    .portrait-shell::after{content:"";position:absolute;inset:0;border-radius:inherit;box-shadow:inset 0 0 0 1px rgba(255,255,255,.06);z-index:2;pointer-events:none}
    .portrait-shell img{width:100%;aspect-ratio:1/1;object-fit:cover;object-position:center center}
    .portrait-caption{position:absolute;z-index:3;inset-inline:26px;bottom:22px;display:flex;align-items:flex-end;justify-content:space-between;gap:20px}
    .portrait-caption strong{display:block;font-family:var(--font-en);font-size:1.08rem}
    .portrait-caption span{display:block;color:#c9c5bf;font-size:.78rem;margin-top:4px}
    .signature{font-family:var(--font-en);font-size:.72rem;color:#d8d2ca;letter-spacing:.12em;text-transform:uppercase;text-align:end}
    .float-card{position:absolute;z-index:4;border:1px solid rgba(255,255,255,.17);background:rgba(15,15,18,.85);backdrop-filter:blur(18px);border-radius:16px;padding:14px 16px;box-shadow:0 18px 40px rgba(0,0,0,.28)}
    .float-card b{display:block;font-family:var(--font-en);font-size:1.22rem;line-height:1.1}
    .float-card small{display:block;color:#aaa6a0;font-size:.68rem;margin-top:6px;white-space:nowrap}
    .float-one{top:9%;inset-inline-start:-36px}.float-two{bottom:15%;inset-inline-end:-34px}

    .trust{border-block:1px solid var(--line);background:rgba(255,255,255,.025)}
    .trust-grid{display:grid;grid-template-columns:repeat(4,1fr)}
    .trust-item{padding:30px clamp(16px,2.6vw,34px);border-inline-end:1px solid var(--line)}
    .trust-item:last-child{border-inline-end:0}
    .trust-num{font-family:var(--font-en);font-size:clamp(1.75rem,3.3vw,2.8rem);font-weight:800;letter-spacing:-.055em;line-height:1;color:#fff}
    .trust-label{margin-top:10px;color:#94908b;font-size:.78rem}

    .work-head{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:46px}
    .work-note{color:#898680;font-size:.8rem;max-width:34ch}
    .cases{display:grid;gap:22px}
    .case-card{position:relative;border:1px solid var(--line);border-radius:var(--radius);background:linear-gradient(145deg,rgba(255,255,255,.045),rgba(255,255,255,.018));overflow:hidden;transition:.28s}
    .case-card:hover{transform:translateY(-5px);border-color:rgba(255,143,107,.45);box-shadow:0 24px 58px rgba(0,0,0,.25)}
    .case-card.featured{display:grid;grid-template-columns:1.08fr .92fr;min-height:470px}
    .case-content{padding:clamp(28px,4vw,52px);display:flex;flex-direction:column}
    .case-tags{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:24px}
    .tag{border:1px solid var(--line);border-radius:999px;padding:6px 10px;color:#b9b6b1;font-family:var(--font-en);font-size:.66rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
    .tag-accent{color:var(--accent-2);border-color:rgba(255,143,107,.35);background:rgba(255,143,107,.08)}
    .case-card h3{font-size:clamp(1.45rem,2.8vw,2.5rem);line-height:1.27;letter-spacing:-.025em;margin:0;max-width:22ch}
    html[dir="rtl"] .case-card h3{letter-spacing:-.01em;line-height:1.45}
    .case-copy{color:#aaa7a2;margin:16px 0 0;max-width:57ch}
    .case-result{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:16px;overflow:hidden;margin-top:auto}
    .case-stat{background:#111115;padding:20px}
    .case-stat b{display:block;font-family:var(--font-en);font-size:clamp(1.35rem,2.6vw,2.1rem);line-height:1.1;letter-spacing:-.04em}
    .case-stat span{display:block;color:#8f8c87;font-size:.7rem;margin-top:8px}
    .case-proof{position:relative;min-height:380px;background:#0f0f12;overflow:hidden;border-inline-start:1px solid var(--line)}
    .case-proof img{width:100%;height:100%;object-fit:cover;object-position:top center;filter:saturate(.82) contrast(1.04);opacity:.92;transition:.4s}
    .case-card:hover .case-proof img{transform:scale(1.025);opacity:1}
    .case-proof::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(13,13,16,.72),transparent 35%),linear-gradient(0deg,rgba(13,13,16,.4),transparent 45%)}
    html[dir="rtl"] .case-proof::after{background:linear-gradient(270deg,rgba(13,13,16,.72),transparent 35%),linear-gradient(0deg,rgba(13,13,16,.4),transparent 45%)}
    .proof-label{position:absolute;z-index:2;bottom:22px;inset-inline:22px;display:flex;align-items:center;justify-content:space-between;gap:18px;color:#e8e2db;font-size:.72rem}
    .proof-label span:first-child{display:flex;align-items:center;gap:8px}.proof-label i{width:7px;height:7px;border-radius:50%;background:var(--success)}
    .case-mini-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}
    .case-card.mini .case-content{min-height:420px}
    .case-card.mini .case-result{margin-top:30px;grid-template-columns:repeat(2,1fr)}
    .case-card.mini .case-stat:last-child:nth-child(3){grid-column:1/-1}
    .case-link{display:inline-flex;align-items:center;gap:9px;margin-top:24px;color:var(--accent-2);font-size:.82rem;font-weight:700}
    .case-link .arr{transition:.2s}.case-link:hover .arr{transform:translateX(-4px)}
    html[dir="ltr"] .case-link:hover .arr{transform:translateX(4px)}

    .approach{border-block:1px solid var(--line);background:linear-gradient(180deg,rgba(255,255,255,.025),rgba(255,255,255,.012))}
    .approach-grid{display:grid;grid-template-columns:.78fr 1.22fr;gap:clamp(40px,7vw,96px);align-items:start}
    .sticky{position:sticky;top:118px}
    .steps{border-top:1px solid var(--line)}
    .step{display:grid;grid-template-columns:58px 1fr;gap:22px;padding:30px 0;border-bottom:1px solid var(--line)}
    .step-no{font-family:var(--font-en);color:var(--accent);font-size:.78rem;font-weight:800;letter-spacing:.1em}
    .step h3{margin:0;font-size:1.18rem}.step p{margin:9px 0 0;color:#9a9691;font-size:.92rem;max-width:60ch}

    .capabilities{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:48px}
    .cap-card{border:1px solid var(--line);border-radius:20px;background:rgba(255,255,255,.025);padding:28px;transition:.25s}
    .cap-card:hover{background:rgba(255,255,255,.05);border-color:var(--line-strong)}
    .cap-icon{width:44px;height:44px;border:1px solid rgba(255,143,107,.35);background:rgba(255,143,107,.08);border-radius:14px;display:grid;place-items:center;color:var(--accent);font-family:var(--font-en);font-weight:800;font-size:.75rem}
    .cap-card h3{margin:22px 0 0;font-size:1.12rem}.cap-card p{margin:10px 0 0;color:#96928d;font-size:.88rem}
    .cap-list{display:flex;flex-wrap:wrap;gap:7px;margin:20px 0 0;padding:0;list-style:none}
    .cap-list li{font-family:var(--font-en);font-size:.64rem;color:#aaa6a0;border:1px solid var(--line);padding:5px 8px;border-radius:999px}

    .proof-section{background:#f0ece5;color:#141416}
    .proof-section .kicker{color:#a64f32}.proof-section .kicker::before{background:#bd5a3a}
    .proof-section .section-intro{color:#66615b}
    .proof-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:16px;margin-top:48px}
    .proof-shot{position:relative;border:1px solid rgba(20,20,22,.14);border-radius:18px;overflow:hidden;background:#fff;cursor:zoom-in;box-shadow:0 14px 38px rgba(30,23,18,.07);transition:.25s}
    .proof-shot:hover{transform:translateY(-4px);box-shadow:0 22px 48px rgba(30,23,18,.12)}
    .proof-shot:nth-child(1){grid-column:span 7}.proof-shot:nth-child(2){grid-column:span 5}.proof-shot:nth-child(3){grid-column:span 4}.proof-shot:nth-child(4){grid-column:span 4}.proof-shot:nth-child(5){grid-column:span 4}.proof-shot:nth-child(6){grid-column:span 6}.proof-shot:nth-child(7){grid-column:span 6}
    .proof-shot img{width:100%;aspect-ratio:16/10;object-fit:cover;object-position:top}
    .proof-caption{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:15px 16px;border-top:1px solid rgba(20,20,22,.1);font-family:var(--font-en);font-size:.68rem;color:#68635d}
    .proof-caption b{color:#1e1d1c;font-size:.72rem}

    .about-grid{display:grid;grid-template-columns:.72fr 1.28fr;gap:clamp(42px,7vw,100px);align-items:center}
    .about-photo{position:relative;border-radius:28px;overflow:hidden;border:1px solid var(--line);background:#19191d}
    .about-photo img{width:100%;aspect-ratio:4/5;object-fit:cover;object-position:center top;filter:saturate(.92) contrast(1.04)}
    .about-photo::after{content:"";position:absolute;inset:0;background:linear-gradient(145deg,transparent 45%,rgba(255,143,107,.17))}
    .about-copy h2{font-size:clamp(2rem,4.4vw,3.8rem);line-height:1.23;letter-spacing:-.04em;margin:0;max-width:15ch}
    html[dir="rtl"] .about-copy h2{line-height:1.42;letter-spacing:-.01em}
    .about-copy>p{color:#aaa6a0;font-size:1.02rem;margin:20px 0 0;max-width:64ch}
    .cred-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:30px}
    .cred{border:1px solid var(--line);border-radius:14px;padding:16px}.cred span{display:block;color:#817e79;font-size:.68rem;margin-bottom:7px}.cred b{font-size:.82rem;font-weight:600}
    .skill-cloud{display:flex;flex-wrap:wrap;gap:8px;margin-top:24px}.skill-cloud span{border:1px solid var(--line);background:rgba(255,255,255,.025);border-radius:999px;padding:7px 11px;color:#b8b4ae;font-family:var(--font-en);font-size:.65rem}

    .contact{padding-bottom:0}
    .contact-panel{position:relative;overflow:hidden;border:1px solid rgba(255,255,255,.14);border-radius:32px;background:linear-gradient(145deg,#19171a,#101014);box-shadow:var(--shadow)}
